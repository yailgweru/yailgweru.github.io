// GENERATED by scripts/build_form_rules.py from the `more.form` blocks in data.json.
// Do not hand-edit. Change the form in data.json, run python scripts/update_site.py,
// then deploy: cd firebase && firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // team › Join the hub
    match /joinRequests/{docId} {
      allow create: if validJoinRequests(request.resource.data);
      allow read, update, delete: if false;
    }
    function validJoinRequests(d) {
      return d.keys().hasAll(['name', 'email', 'phone', 'affiliation', 'interest', 'message', 'consent', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'phone', 'affiliation', 'interest', 'message', 'consent', 'createdAt'])
        && d.createdAt == request.time
        && d.name is string && d.name.size() <= 100 && d.name.size() > 0
        && d.email is string && d.email.size() <= 200 && d.email.size() > 0 && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.phone is string && d.phone.size() <= 40
        && d.affiliation is string && d.affiliation.size() <= 150
        && d.interest in ['Attend sessions and events', 'Volunteer at events', 'Mentor or teach', 'Build a project', 'Something else']
        && d.message is string && d.message.size() <= 1500
        && d.consent == true;
    }

    // partners › Become a partner
    match /partnerRequests/{docId} {
      allow create: if validPartnerRequests(request.resource.data);
      allow read, update, delete: if false;
    }
    function validPartnerRequests(d) {
      return d.keys().hasAll(['name', 'email', 'organisation', 'position', 'phone', 'interest', 'message', 'consent', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'organisation', 'position', 'phone', 'interest', 'message', 'consent', 'createdAt'])
        && d.createdAt == request.time
        && d.name is string && d.name.size() <= 100 && d.name.size() > 0
        && d.email is string && d.email.size() <= 200 && d.email.size() > 0 && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.organisation is string && d.organisation.size() <= 150 && d.organisation.size() > 0
        && d.position is string && d.position.size() <= 100
        && d.phone is string && d.phone.size() <= 40
        && d.interest in ['Sponsor a project', 'Host a workshop or venue', 'Mentor members', 'Speak at an event', 'Something else']
        && d.message is string && d.message.size() <= 2000 && d.message.size() > 0
        && d.consent == true;
    }

    // Everything else is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
